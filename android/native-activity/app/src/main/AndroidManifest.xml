<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="Bevy Shapes (Native)"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Name of the Rust cdylib to load (without lib prefix / .so suffix).
                 Must match the [lib] name in crates/android-native-activity/Cargo.toml. -->
            <meta-data android:name="android.app.lib_name" android:value="bevy_shapes_native" />
        </activity>
    </application>

</manifest>
